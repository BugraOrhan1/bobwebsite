# De Reinigingsdokter — Apache-configuratie
# Kirby-vrije PHP-site (PHP 7.4+, PDO SQLite)

Options -Indexes
RewriteEngine On

# Bescherm gevoelige mappen
RewriteRule ^(app|data)(/|$) - [F,L]

# Bestaande bestanden/mappen direct serveren (assets, media)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Admin-paneel
RewriteRule ^admin(/.*)?$ admin/index.php [L]

# Alles anders naar de frontcontroller
RewriteRule ^ index.php [L]

# Caching voor statische bestanden
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# Compressie
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml
</IfModule>

# Basis security-headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
